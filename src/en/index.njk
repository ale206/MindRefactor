---
layout: base.njk
title: Programming, Agile, Management and Leadership
lang: en
description: Mind Refactor is a publication about programming, Agile, management, leadership, and career advice, where I share insights and experiences from the tech world.
permalink: /en/index.html
---
{% from "macros/tagcloud.njk" import tagCloud %}

<section class="post-list-page">

  {% set homePosts = collections.postsEn | head(2) %}

  {% if homePosts.length %}
  <div class="blog-split-layout">

    <section class="featured-post">
      <header class="post-list-header home-intro-header">
        <div class="post-list-header-content">
          <h1 class="home-intro">Mind Refactor is a publication about programming, Agile, management, leadership, and career advice, where I share insights and experiences from the tech world. I write about what I see while building software and working with teams, including the choices that help people learn, work better together, and grow in their careers.</h1>
        </div>
      </header>

      {% for post in homePosts %}
      {% set featuredImage = post.date | postImagePath(post.data.slug) %}
      <article class="home-article">
        <header class="featured-header">
          <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
          <h2><a href="{{ post.url | url }}">{{ post.data.title }}</a></h2>

          {# ── Tags for featured post ── #}
          {% if post.data.postTags and post.data.postTags.length %}
          <div class="article-tags" style="margin-top: 0.5rem; margin-bottom: 1.5rem;">
            {% for t in post.data.postTags %}
            <a href="{{ ('/en/tags/' + t + '/') | url }}" class="tag-pill">{{ t }}</a>
            {% endfor %}
          </div>
          {% endif %}

          {# ── Featured image (after tags) ── #}
          {% if featuredImage %}
          <div class="featured-hero-image">
            <img
              src="{{ featuredImage | url }}"
              alt="{{ post.data.title }}"
              {% if loop.index0 > 0 %}loading="lazy"{% endif %}
              decoding="async"
            />
          </div>
          {% endif %}
        </header>
        <div class="article-body">
          {{ post.templateContent | safe }}
          <p class="home-full-article-link"><a href="{{ post.url | url }}">Open article page →</a></p>
        </div>
      </article>
      {% endfor %}
    </section>

    <aside class="sidebar-posts">
      {{ tagCloud(collections.tagListEn, "en") }}
      
      <h3 class="sidebar-title" style="margin-top:1.75rem;">About me</h3>
      <div class="about-me-block">
        <img src="{{ '/assets/img/alessio-di-salvo.png' | url }}" alt="Alessio Di Salvo" class="about-me-photo" loading="lazy" decoding="async" />
        <a href="https://alessiodisalvo.it" target="_blank" rel="noopener noreferrer" class="about-me-link">Discover more about me on alessiodisalvo.it</a>
      </div>

      <h3 class="sidebar-title">Recent articles</h3>
      <ol class="post-list" reversed>
        {% for post in collections.postsEn %}
          {% if loop.index0 > 1 and loop.index0 <= 6 %}
          {% set thumb = post.date | postImagePath(post.data.slug) %}
          <li class="post-card">
            {% if thumb %}
            <a href="{{ post.url | url }}" class="post-card-thumb-link" tabindex="-1" aria-hidden="true">
              <img src="{{ thumb | url }}" alt="{{ post.data.title }}" class="post-card-thumb" loading="lazy" decoding="async" />
            </a>
            {% endif %}
            <div class="post-card-content">
              <time class="post-card-date" datetime="{{ post.date | isoDate }}">
                {{ post.date | readableDate }}
              </time>
              <a href="{{ post.url | url }}" class="post-card-title">{{ post.data.title }}</a>

              {# ── Tags for post card ── #}
              {% if post.data.postTags and post.data.postTags.length %}
              <div class="tag-cloud" style="margin-top: 0.25rem; margin-bottom: 0.25rem;">
                {% for t in post.data.postTags %}
                <a href="{{ ('/en/tags/' + t + '/') | url }}" class="tag-pill">{{ t }}</a>
                {% endfor %}
              </div>
              {% endif %}

              {% if post.data.description %}
              <p class="post-card-desc">{{ post.data.description }}</p>
              {% endif %}
            </div>
          </li>
          {% endif %}
        {% endfor %}
      </ol>
      <a href="{{ '/en/articles/' | url }}" class="sidebar-all-link">All articles →</a>
    </aside>

  </div>
  {% else %}
    <p class="post-list-empty">No articles yet — check back soon.</p>
  {% endif %}

</section>
